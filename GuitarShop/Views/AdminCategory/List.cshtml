@model List<Category>
@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Category Manager";
}

<h1>@ViewBag.Title</h1>
<div>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible">
            <button type="button" class="close" data-dismiss="alert" aria-label="close">
                <span aria-hidden="true">&times;</span>
            </button>
            @TempData["Message"]
        </div>
    }
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th></th>
                <th></th>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.CategoryName</td>
                    <td>
                        <a asp-action="Update"
                           asp-route-id="@category.CategoryID">Update</a>
                    </td>
                    <td>
                        <a asp-action="Delete"
                           asp-route-id="@category.CategoryID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Add" class="btn btn-primary">Add New Category</a>
</div>